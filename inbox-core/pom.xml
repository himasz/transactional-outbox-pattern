<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>de.ebrahim</groupId>
    <artifactId>outbox-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>inbox-core</artifactId>
  <name>Transactional Outbox :: Inbox (idempotent consumer)</name>

  <dependencies>
    <!-- Framework-free, exactly like outbox-core: plain JDBC, plain jnats.

         Deliberately NO dependency on outbox-core. The inbox hands the handler
         an open transaction and does not care what else is written on it, so a
         service that consumes one event and produces another composes the two
         libraries without either knowing about the other. See ChainingTest,
         where outbox-core appears at test scope only. -->
    <dependency><groupId>io.nats</groupId><artifactId>jnats</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>

    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>provided</scope></dependency>

    <!-- Tests run against real PostgreSQL: the claim upsert relies on how
         ON CONFLICT DO UPDATE re-evaluates its WHERE clause after waiting on a
         concurrent inserter, which no fake reproduces. -->
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>postgresql</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><scope>test</scope></dependency>

    <!-- Test scope only, and only so ChainingTest can prove that an inbox claim
         and an outbox enqueue commit as one unit. Nothing in src/main touches it. -->
    <dependency><groupId>de.ebrahim</groupId><artifactId>outbox-core</artifactId><version>${project.version}</version><scope>test</scope></dependency>
  </dependencies>
</project>
